# ============================================================================
# growCo. Showcase - variaveis de ambiente
# ============================================================================
#
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel em
# Project Settings -> Environment Variables (producao) e faca um novo deploy.
#
# Todas sao opcionais: sem elas a showcase funciona normalmente.
# (NEXT_PUBLIC_* e embutido no build - alterou? precisa de novo deploy.)

# Para onde o botao "Voltar para a growCo." (inicio da showcase) leva.
# Sem valor, aponta para "/" ate a landing page existir.
NEXT_PUBLIC_GROWCO_LANDING_URL=

# Para onde o botao "Abrir o app" (footer) leva.
NEXT_PUBLIC_GROWCO_APP_URL=

# Imagem do QR code do app (arquivo dentro de /public).
# Ex.: /brand/growco-app-qr.png
# Sem valor, o footer mostra o espaco reservado para o QR.
NEXT_PUBLIC_GROWCO_APP_QR_SRC=
